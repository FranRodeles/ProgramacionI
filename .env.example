# Copiá este archivo a `.env` (no se sube al repositorio).

# --- Local (SQLite) ---
# Solo para desarrollo. No se usa en producción.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# --- Producción: PostgreSQL (Railway/Render inyecta DATABASE_URL) ---
# PostgreSQL ES una base de datos SQL, así que no hay conflicto: en Railway/Render
# elegís el servicio "PostgreSQL" y la plataforma inyecta DATABASE_URL sola.
# Si DATABASE_URL está definida, se usa en lugar de las variables DB_* de arriba.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Cifrado de campos sensibles (Fernet) ---
# Opcional: si no se define, se deriva desde DJANGO_SECRET_KEY.
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=<pegar-aqui-la-clave-generada>

# --- CORS: orígenes permitidos separados por coma ---
# En producción agregar el dominio de Vercel:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://mi-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
