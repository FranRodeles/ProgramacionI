# Copiá este archivo a `frontend/.env` (no se sube al repositorio).

# URL base de la API (SIN el sufijo /api). Vite la inyecta en build time.
# Local:
VITE_API_BASE_URL=http://localhost:8000
# Producción (descomentá y poné tu URL de Railway/Render):
# VITE_API_BASE_URL=https://mi-api-production.up.railway.app
