    {
      "name": "02 - Autenticación y Usuarios",
      "item": [
        {
          "name": "1. Registrar Usuario (Público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario creado (201) o ya existente (400)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('user_id', data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"first_name\": \"{{first_name}}\",\n  \"last_name\": \"{{last_name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ""]
            },
            "description": "Registra un nuevo usuario con rol USER y valida la fortaleza de la contraseña."
          }
        },
        {
          "name": "2. Iniciar Sesión (Obtener JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login exitoso (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.access) {",
                  "    pm.collectionVariables.set('access_token', data.access);",
                  "}",
                  "if (data.refresh) {",
                  "    pm.collectionVariables.set('refresh_token', data.refresh);",
                  "}",
                  "pm.test('Tokens JWT guardados en variables de colección', function () {",
                  "    pm.expect(data.access).to.be.a('string');",
                  "    pm.expect(data.refresh).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", ""]
            },
            "description": "Obtiene los tokens `access` y `refresh` y los guarda automáticamente en las variables de la colección."
          }
        },
        {
          "name": "3. Ver Mi Perfil (/api/profile/)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.id) {",
                  "    pm.collectionVariables.set('user_id', data.id);",
                  "}",
                  "pm.test('Username coincide con el usuario autenticado', function () {",
                  "    pm.expect(data.username).to.eql(pm.collectionVariables.get('username'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/profile/",
              "host": ["{{base_url}}"],
              "path": ["api", "profile", ""]
            },
            "description": "Devuelve los datos del usuario autenticado."
          }
        },
        {
          "name": "4. Actualizar Mi Perfil (PATCH /api/profile/)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK y rol protegido contra escalada', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.first_name).to.eql('Francisco Actualizado');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Francisco Actualizado\",\n  \"last_name\": \"Rodeles\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/profile/",
              "host": ["{{base_url}}"],
              "path": ["api", "profile", ""]
            },
            "description": "Actualiza parcialmente el perfil del usuario autenticado (el campo `role` es de solo lectura)."
          }
        },
        {
          "name": "5. Refrescar Token JWT (Con Rotación)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh exitoso (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.access) {",
                  "    pm.collectionVariables.set('access_token', data.access);",
                  "}",
                  "if (data.refresh) {",
                  "    pm.collectionVariables.set('refresh_token', data.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", "refresh", ""]
            },
            "description": "Renueva el `access_token` y rota el `refresh_token` (invalidando el anterior en la blacklist)."
          }
        },
        {
          "name": "6. Obtener Usuario por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}", ""]
            },
            "description": "Consulta el detalle del usuario propio (o de cualquier usuario si el rol es ADMIN)."
          }
        },
        {
          "name": "7. Listar Todos los Usuarios (Solo ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 si es ADMIN o 403 si es USER normal', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/users/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ""]
            },
            "description": "Endpoint protegido por permiso `IsAdmin`. Devuelve 403 Forbidden para usuarios con rol `USER`."
          }
        }
      ]
    },
